<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Aktualizacja apki z wydań na GitHubie (ApkUpdater → PackageInstaller). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="DeepSeek Harness"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Czytnik/edytor .md (MdActivity + assets/md); nieeksportowany, otwiera go tylko Opener i linki z dokumentu. -->
        <activity android:name=".MdActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode" />
        <service android:name=".ServerService" android:exported="false" />
        <!-- xdg-open z serwera dsh (Opener.kt): pliki dla innych apek tylko z nadanym uprawnieniem do URI. -->
        <provider android:name=".FilesProvider" android:authorities="com.dsh.mobile.files"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
